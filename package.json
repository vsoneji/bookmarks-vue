    "@vitejs/plugin-vue": "^5.2.4",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "rimraf": "^6.0.1",
    "sass": "^1.89.0",
    "vite": "^6.3.5",
    "vue": "^3.5.15",
    "vue-eslint-parser": "^10.1.3"
  }
